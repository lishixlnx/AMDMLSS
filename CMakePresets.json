{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "description": "Base settings for Windows builds",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "environment": {
                "HIP_PATH": "C:/opt/rocm",
                "HIP_PLATFORM": "amd",
                "HIP_USE_PERL_SCRIPTS": "0"
            },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{HIP_PATH};$env{HIP_PATH}/lib/cmake;$env{CMAKE_PREFIX_PATH}",
                "CMAKE_MODULE_PATH": "$env{HIP_PATH}/cmake;$env{CMAKE_MODULE_PATH}"
            }
        },
        {
            "name": "windows-clang-base",
            "hidden": true,
            "description": "Base settings for Clang builds on Windows",
            "inherits": "windows-base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "$env{HIP_PATH}/bin/clang.exe",
                "CMAKE_CXX_COMPILER": "$env{HIP_PATH}/bin/clang++.exe",
                "CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "${sourceDir}/tools/clang-scan-deps-wrapper.cmd",
                "CMAKE_CXX_FLAGS": "-Wno-unused-command-line-argument -fasync-exceptions",
                "CMAKE_C_FLAGS": "-Wno-unused-command-line-argument"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "description": "Base settings for Linux builds (Ubuntu/RHEL, WSL or native)",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "generator": "Ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "environment": {
                "HIP_PATH": "/opt/rocm",
                "ROCM_PATH": "/opt/rocm",
                "HIP_PLATFORM": "amd"
            },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{HIP_PATH};$env{HIP_PATH}/lib/cmake;$env{CMAKE_PREFIX_PATH}",
                "CMAKE_MODULE_PATH": "$env{HIP_PATH}/cmake;$env{CMAKE_MODULE_PATH}"
            }
        },
        {
            "name": "linux-clang-base",
            "hidden": true,
            "description": "Base settings for Clang builds on Linux",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_CXX_FLAGS": "-Wno-unused-command-line-argument",
                "CMAKE_C_FLAGS": "-Wno-unused-command-line-argument"
            }
        },
        {
            "name": "linux-gcc-base",
            "hidden": true,
            "description": "Base settings for GCC builds on Linux",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "mode-none",
            "hidden": true,
            "description": "Library only: no unit tests, no sample tests (no test dependencies fetched)",
            "cacheVariables": {
                "BUILD_UNIT_TESTS": "OFF",
                "BUILD_SAMPLE_TESTS": "OFF"
            }
        },
        {
            "name": "mode-unit",
            "hidden": true,
            "description": "Unit tests only (fetches Catch2 + amd-mlss-tester)",
            "cacheVariables": {
                "BUILD_UNIT_TESTS": "ON",
                "BUILD_SAMPLE_TESTS": "OFF"
            }
        },
        {
            "name": "mode-samples",
            "hidden": true,
            "description": "Sample tests only (no test dependencies fetched)",
            "cacheVariables": {
                "BUILD_UNIT_TESTS": "OFF",
                "BUILD_SAMPLE_TESTS": "ON"
            }
        },
        {
            "name": "vs2026-debug",
            "displayName": "Visual Studio 2026 Debug",
            "description": "Configure with Visual Studio 2026 (Debug); unit + sample tests",
            "inherits": "windows-base",
            "generator": "Visual Studio 18 2026",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "vs2026-debug-none",
            "displayName": "Visual Studio 2026 Debug (no tests)",
            "inherits": [
                "vs2026-debug",
                "mode-none"
            ]
        },
        {
            "name": "vs2026-debug-unit",
            "displayName": "Visual Studio 2026 Debug (unit tests)",
